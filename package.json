{
  "name": "columbina-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Columbina Admin —— 给 Firefly 博客用的本地内容管理后台（Fastify + Vue3）",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "tsc -p tsconfig.server.json && vite build && node dist-server/index.js",
    "start:fast": "node dist-server/index.js",
    "dev": "tsc -p tsconfig.server.json && concurrently -n api,web -c cyan,magenta \"node dist-server/index.js\" \"vite\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "check:web": "node scripts/check-web.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "gray-matter": "^4.0.3",
    "sharp": "^0.34.1",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "axios": "^1.7.9",
    "codemirror": "^6.0.1",
    "concurrently": "^9.1.2",
    "element-plus": "^2.9.5",
    "vite": "^6.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
